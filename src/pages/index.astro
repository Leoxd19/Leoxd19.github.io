---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Leo Gardberg">
  <div class="heroContent">
    <h1 class="name">Leo Gardberg</h1>
    <p>currently @ <a href="https://furhatrobotics.com" target="_blank" class="logoLink"><img src="/furhatlogo.png" alt="Furhat Robotics" class="logo" /></a> — working with social robots</p>
    <figure class="photoFrame">
      <img src="/leo1.jpg" alt="Leo with Furhat robots" class="photo" />
    </figure>
    <section class="builtSection" aria-label="Shipped">
      <h2 class="sectionHeading">// shipped</h2>

      <article class="project">
        <img src="/misty-connect-icon.png" alt="" class="appIcon" />
        <h3 class="projectTitle">Misty Connect</h3>
        <span class="projectMeta">iOS · Flutter · BLE</span>
        <p class="projectBlurb">
          A Bluetooth provisioning tool for users and developers of the Misty II robot. Discovers nearby robots over BLE, exchanges binary frames across a custom GATT service to hand off Wi-Fi credentials, and returns the assigned IP. Pure-Dart protocol layer, fully unit-tested. Previously seen robots are cached for one-tap reconnects.
        </p>
        <ul class="platformList">
          <li class="platformRow">
            <span class="platformName">iOS</span>
            <span class="platformDivider">—</span>
            <a href="https://apps.apple.com/us/app/misty-connect/id6771731417" target="_blank" rel="noopener" class="platformLink">live on the App Store ↗</a>
          </li>
          <li class="platformRow">
            <span class="platformName">Android</span>
            <span class="platformDivider">—</span>
            <span class="platformPending">pending Google Play release</span>
          </li>
        </ul>
      </article>
    </section>

    <dotlottie-wc src="/animation.lottie" autoplay loop class="mascot"></dotlottie-wc>

    <span class="soon">// more soon</span>
  </div>
</BaseLayout>

<style>
  .heroContent {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.5rem;
    text-align: center;
  }

  .name {
    font-size: 1.8rem;
    font-weight: 400;
    letter-spacing: 0.05em;
  }

  .logoLink {
    line-height: 0;
  }

  .logo {
    display: inline-block;
    vertical-align: middle;
    width: 140px;
    height: auto;
    opacity: 0.9;
    filter: invert(1);
  }

  .photoFrame {
    margin: 0;
    width: min(420px, 90vw);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
  }

  .photo {
    display: block;
    width: 100%;
    height: auto;
  }

  .mascot {
    width: min(380px, 90vw);
    aspect-ratio: 19 / 10;
  }

  .soon {
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.01em;
  }

  .builtSection {
    width: min(520px, 100%);
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .sectionHeading {
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.01em;
    margin-bottom: 1.75rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
    max-width: 440px;
    padding: 2rem 1.75rem;
    background: #131313;
    border: 1px solid #1f1f1f;
    border-radius: 16px;
  }

  .appIcon {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    margin-bottom: 0.4rem;
  }

  .projectTitle {
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-wrap: balance;
  }

  .projectMeta {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .projectBlurb {
    font-size: 1rem;
    line-height: 1.7;
    margin-top: 0.3rem;
    max-width: 44ch;
    overflow-wrap: break-word;
    text-wrap: pretty;
    hyphens: auto;
  }

  .platformList {
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 0.9rem;
  }

  .platformRow {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .platformName {
    min-width: 3.5rem;
    text-align: right;
    letter-spacing: 0.05em;
  }

  .platformDivider {
    opacity: 0.4;
  }

  .platformLink {
    color: #e8e8e8;
    text-decoration: none;
    border-bottom: 1px solid #e8e8e8;
    padding-bottom: 1px;
    transition: opacity 0.15s ease;
  }

  .platformLink:hover {
    opacity: 0.7;
  }

  .platformPending {
    font-style: italic;
  }

  @media (max-width: 480px) {
    .heroContent {
      gap: 1.25rem;
    }

    .name {
      font-size: 1.2rem;
    }

    .logo {
      width: 90px;
    }

    .photoFrame {
      width: min(320px, 85vw);
    }

    .mascot {
      width: min(300px, 80vw);
    }

    .soon {
      font-size: 0.9rem;
    }

    .builtSection {
      margin-top: 0.75rem;
    }

    .sectionHeading {
      font-size: 0.9rem;
      margin-bottom: 1.5rem;
    }

    .project {
      gap: 0.55rem;
      padding: 1.75rem 1.25rem;
      border-radius: 14px;
      width: 100%;
    }

    .appIcon {
      width: 58px;
      height: 58px;
      border-radius: 13px;
      margin-bottom: 0.2rem;
    }

    .projectTitle {
      font-size: 1rem;
    }

    .projectMeta {
      font-size: 0.75rem;
    }

    .projectBlurb {
      font-size: 0.88rem;
      line-height: 1.7;
      margin-top: 0.1rem;
    }

    .platformList {
      font-size: 0.8rem;
      gap: 0.3rem;
    }

    .platformName {
      min-width: 3rem;
    }
  }
</style>
