---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import goya from "../assets/goya-sleep-of-reason.jpg";

// The portrait above the name fades through these, in this order. Warcraft III icons from Hive
// Workshop (hiveworkshop.com), by bigapple90, 67chrome, FrIkY, Sopho,
// Elf Knight-, Freezer, Scias, LoDown and Darkfang, duotoned in the page's
// ink and paper so they read like the etching.
const portraits = [
  ["carrion-swarm", "Carrion Swarm"],
  ["sylvanas", "Sylvanas"],
  ["warglaive", "Warglaive"],
  ["ninja", "Ninja"],
  ["rivendare", "Rivendare"],
  ["electric-blizzard", "Electric Blizzard"],
  ["tyrande", "Tyrande"],
  ["cultist-rogue", "Cultist Rogue"],
  ["rocket-boots", "Rocket Boots"],
  ["frost-lich", "Frost Lich"],
  ["cultist-assassin", "Cultist Assassin"],
].map(([slug, name]) => ({ src: `/avatar-${slug}.jpg`, name }));

// On the details sheet: a keyword and one line each.
const details = [
  ["BLE", "Discovers nearby Misty II robots."],
  ["GATT", "A custom service exchanges Wi-Fi credentials and reads back the assigned IP."],
  ["Dart", "Pure-Dart protocol layer, fully unit-tested."],
  ["Cache", "Remembers the robots it has seen, for one-tap reconnects."],
];
---

<BaseLayout title="Leo Gardberg — working with social robots">
  <div class="page">
    <figure class="plate">
      <Picture
        src={goya}
        formats={["avif", "webp"]}
        widths={[480, 720, 960, 1200, 1500, 1800]}
        sizes="(max-width: 767px) 20rem, (max-aspect-ratio: 1/1) 20rem, 40vh"
        quality={40}
        loading="eager"
        fetchpriority="high"
        alt="Goya's etching The Sleep of Reason Produces Monsters: a man asleep at a desk inscribed with the title, while owls and bats rise behind him."
      />
      <figcaption class="credit glass">
        Goya, <cite>El sueño de la razón produce monstruos</cite>, 1799
      </figcaption>
    </figure>

    <main class="content">
      <header class="intro">
        <!-- The portrait: one icon at a time on a small glass tile, slowly
             fading to the next. A click or tap moves it on. It is
             decoration, so it is hidden from screen readers and skipped by
             the Tab key. -->
        <button
          type="button"
          id="portrait"
          class="portrait glass"
          tabindex="-1"
          aria-hidden="true"
          data-srcs={portraits.map((icon) => icon.src).join(",")}
        >
          <img src={portraits[0].src} alt="" class="portraitLayer isTop" width="56" height="56" />
          <img src={portraits[1].src} alt="" class="portraitLayer" width="56" height="56" />
        </button>

        <div class="nameLine">
          <h1 class="name">Leo Gardberg</h1>
          <!-- Things I like, as small "emoji". Frostsaber: World of Warcraft's Winterspring Frostsaber mount icon (Blizzard). -->
          <span class="traits">
            <span class="trait glass"><img src="/trait-frostsaber.jpg" alt="Frostsaber" width="56" height="56" /></span>
          </span>
        </div>
        <p class="tagline">
          Working with social robots
          <span class="atFurhat">@ <a href="https://furhatrobotics.com" target="_blank" rel="noopener" class="logoLink"><span class="logo" role="img" aria-label="Furhat Robotics"></span></a></span>
        </p>
        <!-- Peon icon by Kristiel (Hive Workshop, "BTNW3/1Peon Variants"). -->
        <p class="quote">
          <img src="/peon.jpg" alt="" class="quoteIcon" width="24" height="24" />
          <span><q>Work work.</q> <span class="quoteBy">— Peon, <cite>Warcraft III</cite> (2002)</span></span>
        </p>
      </header>

      <section class="projects" aria-label="Projects">
        <h2 class="srOnly">Projects</h2>

        <article class="project">
          <header class="projectHead">
            <img src="/misty-connect-icon.png" alt="" class="appIcon" width="40" height="40" />
            <h3 class="projectTitle">Misty Connect</h3>
          </header>
          <p class="projectBlurb">
            Gets a Misty II onto your Wi&#8209;Fi over Bluetooth. Find the robot, send it your network credentials, and get back the IP it was assigned.
          </p>
          <!-- Official store badges, unmodified, per Apple's and Google's guidelines. -->
          <div class="badges">
            <a href="https://apps.apple.com/us/app/misty-connect/id6771731417" target="_blank" rel="noopener" class="badge">
              <img src="/badge-app-store.svg" alt="Download on the App Store" width="120" height="40" />
            </a>
            <a href="https://play.google.com/store/apps/details?id=com.furhat.misty_connect" target="_blank" rel="noopener" class="badge badgePlay">
              <img src="/badge-google-play.png" alt="Get it on Google Play" width="154" height="60" />
            </a>
          </div>
          <!-- The details open as a popover: a native browser feature that
               puts the sheet in a layer above the page, closes it on Escape
               or a click outside, and tells screen readers whether it is
               open, all without script. Because it floats, opening it moves
               nothing else on the page. -->
          <button type="button" class="expandToggle glass" popovertarget="details">
            <span>details</span>
            <span class="plus" aria-hidden="true"></span>
          </button>
          <div id="details" class="sheet glass" popover>
            <p class="projectNote">
              The official replacement for the removed Misty App, so owners of Misty II (built by Misty Robotics in Boulder, Colorado) can get their robots online for research, teaching or private use.
            </p>
            <ul class="facts">
              {details.map(([key, text]) => (
                <li class="fact">
                  <span class="factKey">{key}</span>
                  {text}
                </li>
              ))}
            </ul>
            <div class="stack">
              <span class="techIcon techFlutter" role="img" aria-label="Flutter" title="Flutter">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.314 0L2.3 12 6 15.7 21.684.013h-7.37zm.014 11.072L7.857 17.53l6.471 6.47H21.7l-6.46-6.468 6.46-6.46z"/></svg>
              </span>
              <span class="techIcon" title="Dart"><img src="/dart-logo.png" alt="Dart" width="48" height="48" /></span>
              <span class="techIcon techBle" role="img" aria-label="Bluetooth Low Energy" title="Bluetooth Low Energy">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.71 7.71L12 2h-1v7.59L6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 11 14.41V22h1l5.71-5.71-4.3-4.29 4.3-4.29zM13 5.83l1.88 1.88L13 9.59V5.83zm1.88 10.46L13 18.17v-3.76l1.88 1.88z"/></svg>
              </span>
            </div>
          </div>
        </article>
      </section>

    </main>

    <!-- Avatar and peon icons are fan-made (Hive Workshop, artists named at
         the top of this file and beside the peon); the frostsaber is Blizzard's. -->
    <footer class="colophon">
      Icons from <a href="https://www.hiveworkshop.com" target="_blank" rel="noopener">Hive Workshop</a> artists and Blizzard
    </footer>
  </div>
</BaseLayout>

<script>
  // The portrait fades through the icons listed in data-srcs, as a
  // crossfade between two stacked layers: the next icon fades in on top of
  // the current one, so there is never an empty frame. Each image is
  // decoded before its fade starts so it can't pop in mid-transition. It
  // pauses while the tab is hidden; with prefers-reduced-motion it doesn't
  // play on its own, and only a click or tap moves it on.
  const portrait = document.getElementById("portrait");
  const layers = portrait
    ? Array.from(portrait.querySelectorAll<HTMLImageElement>(".portraitLayer"))
    : [];
  if (portrait && layers.length === 2) {
    const sources = (portrait.dataset.srcs ?? "").split(",").filter(Boolean);
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const HOLD_MS = 4000;
    const FADE_MS = 900; // keep in sync with .portraitLayer's transition
    let i = 0;
    let top = 0;
    let busy = false;
    let timer: number | undefined;

    // Preload the rest so every crossfade has its image ready.
    sources.slice(2).forEach((src) => {
      const img = new Image();
      img.src = src;
    });

    const next = async () => {
      if (busy || sources.length < 2) return;
      busy = true;
      i = (i + 1) % sources.length;
      const incoming = layers[1 - top];
      const outgoing = layers[top];
      incoming.src = sources[i];
      try {
        await incoming.decode();
      } catch {
        // Decode can reject for cached or aborted images; show it anyway.
      }
      incoming.style.zIndex = "2";
      outgoing.style.zIndex = "1";
      incoming.classList.add("isTop");
      // Drop the old layer only once the new one is fully opaque above it.
      window.setTimeout(() => {
        outgoing.classList.remove("isTop");
        top = 1 - top;
        busy = false;
      }, reduceMotion ? 0 : FADE_MS);
    };

    const play = () => {
      if (!reduceMotion && timer === undefined) timer = window.setInterval(next, HOLD_MS);
    };

    const pause = () => {
      clearInterval(timer);
      timer = undefined;
    };

    play();
    document.addEventListener("visibilitychange", () => (document.hidden ? pause() : play()));

    // A click moves on at once and restarts the wait for the next one.
    portrait.addEventListener("click", () => {
      pause();
      next();
      play();
    });
  }

  // Glass surfaces catch the light from the pointer: each one is told where
  // the cursor is relative to its own corner, and its CSS paints a soft
  // highlight there. Only custom properties change, so nothing is laid out
  // again, and the work is batched to one update per frame.
  const glass = Array.from(document.querySelectorAll<HTMLElement>(".glass"));
  let pointer: PointerEvent | undefined;
  window.addEventListener(
    "pointermove",
    (event) => {
      if (!pointer) {
        requestAnimationFrame(() => {
          if (!pointer) return;
          for (const el of glass) {
            const box = el.getBoundingClientRect();
            el.style.setProperty("--mx", `${pointer.clientX - box.left}px`);
            el.style.setProperty("--my", `${pointer.clientY - box.top}px`);
          }
          pointer = undefined;
        });
      }
      pointer = event;
    },
    { passive: true },
  );
</script>

<style>
  /* A centred, symmetric composition: print, gap and text column form one
     block centred in the viewport, so the outer margins are equal. The
     print is 60% of the viewport height at its own 2645:4000 ratio (never
     cropped) and sits on the paper like a real impression of the
     Caprichos, its centre level with the centre of the text. */
  .page {
    --plate-h: clamp(18rem, 60vh, 44rem);
    --plate-h: clamp(18rem, 60dvh, 44rem);
    --plate-w: calc(var(--plate-h) * 0.66125);
    display: grid;
    grid-template-columns: var(--plate-w) minmax(0, 36rem);
    justify-content: center;
    align-items: center;
    column-gap: clamp(3rem, 6vw, 7rem);
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }

  /* The credit is positioned against this box, on top of the print. */
  .plate {
    position: relative;
    animation: fade 0.9s ease both;
  }

  /* <Picture> renders its own elements, outside this component's style
     scope, hence :global(). */
  .plate :global(picture) {
    display: block;
    height: var(--plate-h);
  }

  /* A barely-there radius: real etching plates have their corners filed
     round so they don't cut the paper, which softens the plate mark. */
  .plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  /* Fits one screen on desktop: the whole column sits within the viewport
     height, vertically centred against the print. */
  .content {
    --ease: cubic-bezier(0.2, 0.7, 0.2, 1);
    /* Overshoots its target a little before settling, like a spring. */
    --spring: cubic-bezier(0.3, 1.6, 0.5, 1);
    /* The weight of the plus sign's two bars. */
    --line: 2.5px;
    display: flex;
    flex-direction: column;
    padding-block: clamp(0.75rem, 2.5vh, 2rem);
    text-align: center;
  }

  /* The column arrives in order, top to bottom: each block rises a few
     pixels into place, slightly after the one above it. */
  .content > * {
    animation: rise 0.8s var(--ease) both;
  }

  .content > :nth-child(2) { animation-delay: 0.12s; }

  /* Rising out of a slight blur makes each block seem to come into focus
     rather than just slide. */
  @keyframes rise {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(10px);
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  /* --- Intro ----------------------------------------------------- */

  /* Everything in the column is set on its centre line, like a title
     page: the print is one centred object, the text beside it another. */
  .intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }

  /* --- Portrait --------------------------------------------------- */

  /* A glass tile with the icon set into it. The padding is the frosted
     margin around the icon; the two radii differ by exactly that padding,
     which keeps the inner and outer corners concentric. */
  .portrait {
    --size: 56px;
    --pad: 5px;
    position: relative;
    width: calc(var(--size) + 2 * var(--pad));
    height: calc(var(--size) + 2 * var(--pad));
    margin-bottom: clamp(0.9rem, 2.4vh, 1.4rem);
    padding: 0;
    border: 0;
    border-radius: 19px;
    cursor: pointer;
    transition: transform 0.45s var(--spring);
  }

  .portrait:hover {
    transform: scale(1.06);
  }

  .portrait:active {
    transform: scale(0.96);
  }

  /* Two stacked layers for the crossfade; only .isTop is visible. */
  .portraitLayer {
    position: absolute;
    inset: var(--pad);
    width: var(--size);
    height: var(--size);
    border-radius: 14px;
    opacity: 0;
    transition: opacity 0.9s ease-in-out;
  }

  .portraitLayer.isTop {
    opacity: 1;
  }

  /* The name keeps the exact centre; the trait icons hang off its right
     edge without being counted in its width. */
  .nameLine {
    position: relative;
  }

  /* Large, tight and heavy enough to carry the page without a band
     behind it. */
  .name {
    font-size: clamp(2rem, 1.55rem + 1.5vw, 2.8rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  /* Personal "emoji" after the name: the same rounded-square shape as the
     portrait, so they read as one set. */
  .traits {
    position: absolute;
    top: 50%;
    left: calc(100% + 0.7rem);
    display: flex;
    gap: 0.35rem;
    transform: translateY(-50%);
  }

  /* A small glass tile, the portrait's little sibling. max-width: none
     because the row is positioned outside the name's box and has no width
     of its own for the global max-width: 100% to measure against. */
  .trait {
    display: block;
    flex-shrink: 0;
    width: 32px;
    max-width: none;
    height: 32px;
    padding: 3px;
    border-radius: 10px;
  }

  .trait img {
    width: 100%;
    height: 100%;
    border-radius: 7px;
  }

  .tagline {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.2rem 0.45rem;
    line-height: 1.4;
    color: var(--ink);
  }

  /* The peon's line, as a small aside to "working with social robots". The
     icon keeps its green on purpose: in duotone he stops reading as a peon. */
  .quote {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.55rem;
    margin-top: clamp(0.4rem, 1.2vh, 0.8rem);
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .quoteIcon {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    flex-shrink: 0;
  }

  /* The attribution wraps as one unit, never leaving "(2002)" alone. */
  .quoteBy {
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .quoteBy cite {
    font-style: normal;
  }

  /* "@" and the logo stay together, so on narrow screens the line breaks
     at the natural pause instead of leaving "@" dangling. The logo artwork
     starts ~7% into its image, so it's pulled left to sit about one normal
     space from the "@". */
  .atFurhat {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .atFurhat .logoLink {
    margin-left: -0.35rem;
  }

  .logoLink {
    display: inline-block;
    color: var(--ink);
    line-height: 0;
  }

  /* The wordmark is a transparent mask filled with currentColor, so it
     always matches the text ink instead of carrying its own black. The
     artwork has generous built-in padding, hence the larger box. */
  .logo {
    display: block;
    width: 150px;
    aspect-ratio: 560 / 156;
    margin-block: -0.4rem;
    background: currentColor;
    -webkit-mask: url("/furhat-logo-mask.png") center / contain no-repeat;
    mask: url("/furhat-logo-mask.png") center / contain no-repeat;
  }

  /* --- Project --------------------------------------------------- */

  /* No card, label or rule: whitespace alone separates the app from the
     intro. */
  .projects {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: clamp(2.25rem, 7vh, 4rem);
  }

  /* Machine details (the toggle, the fact keywords) are set in mono: one
     "label" voice under the sans reading voice. */
  .factKey,
  .expandToggle {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--ink);
  }

  .project {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    width: 100%;
  }

  .projectHead {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.8rem;
  }

  .projectTitle {
    font-size: 1.55rem;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
  }

  .techIcon {
    display: inline-flex;
    line-height: 0;
  }

  .techIcon svg {
    width: 15px;
    height: 15px;
  }

  .techIcon img {
    width: 17px;
    height: 17px;
    object-fit: contain;
  }

  /* Brand colors, each the brand's own darker shade (or deepened just
     enough) to clear 3:1 against the paper. Raster logos keep their art. */
  .techFlutter { color: #02569b; }
  .techBle     { color: #0a5bc4; }

  /* App icon artwork is square; the store applies the rounded mask, so we
     round it the same way (~22% radius, like iOS) to read as an app icon. */
  .appIcon {
    width: 36px;
    height: 36px;
    border-radius: 22%;
  }

  /* Balanced wrapping evens out the line lengths, which centred text
     needs: one short last line under two long ones looks lopsided. */
  .projectBlurb {
    max-width: 31rem;
    line-height: 1.55;
    text-wrap: balance;
  }

  /* Background context, on the details sheet. */
  .projectNote {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink);
    text-wrap: balance;
  }

  /* --- Store badges ----------------------------------------------- */

  .badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }

  .badge {
    display: block;
    line-height: 0;
    border-radius: 7px;
    transition: opacity 0.15s ease, transform 0.3s var(--ease);
  }

  .badge:hover {
    opacity: 0.85;
    transform: translateY(-1px);
  }

  .badge img {
    height: 40px;
    width: auto;
  }

  /* Google's PNG ships with transparent clear space (41 of 250px on each
     side). Size it so the visible badge matches Apple's 40px, then pull the
     padding back so both badges line up. max-width: none is needed: the
     link shrinks to the image minus those negative margins, and the global
     max-width: 100% would then squeeze the image ~13% narrower. */
  .badgePlay img {
    height: 59.5px;
    max-width: none;
    margin: -9.75px;
  }

  /* --- Details ---------------------------------------------------- */

  /* The toggle is a small glass capsule: a label and a plus that turns
     into a minus. It gives slightly under the finger. "anchor-name" lets
     the sheet position itself against this button (see .sheet). */
  .expandToggle {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.6rem;
    margin-top: 0.5rem;
    padding: 0.45rem 0.95rem;
    border: 0;
    border-radius: 999px;
    letter-spacing: 0.04em;
    cursor: pointer;
    user-select: none;
    anchor-name: --details-toggle;
    transition: transform 0.3s var(--ease);
  }

  .expandToggle:hover {
    transform: scale(1.04);
  }

  .expandToggle:active {
    transform: scale(0.96);
  }

  /* Two bars crossed. While the sheet is open the upright one turns flat
     onto the other, and the whole sign makes a half turn on the way. The
     button can tell because the sheet is its next sibling: :has() looks
     ahead for it in the open state. */
  .plus {
    position: relative;
    width: 11px;
    height: 11px;
    transition: transform 0.5s var(--ease);
  }

  .plus::before,
  .plus::after {
    content: "";
    position: absolute;
    top: calc(50% - var(--line) / 2);
    left: 0;
    width: 100%;
    height: var(--line);
    border-radius: 99px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }

  .plus::after {
    transform: rotate(90deg);
  }

  .expandToggle:has(+ .sheet:popover-open) .plus {
    transform: rotate(180deg);
  }

  .expandToggle:has(+ .sheet:popover-open) .plus::after {
    transform: rotate(0deg);
  }

  /* The sheet: a pane of glass floating over the page with the background
     note, four facts and what the app is built with. It is more opaque
     and blurs harder than the other glass, because here there is text
     behind it that must not compete with the text on it.

     Closed, a popover is display: none, which normally can't be animated.
     Three newer pieces of CSS make it possible:
     - "allow-discrete" on display and overlay keeps the sheet rendered,
       and in the top layer, until its fade-out has finished;
     - @starting-style gives the values to animate from on the first
       frame after it appears;
     - the closed values on .sheet itself are what it animates back to. */
  .sheet {
    --glass-blur: 26px;
    /* Frosted at the top, where the name shows through, and solid from the
       middle down, so the black store badges behind the lower half don't
       show as a dark smudge. The first layer is the pointer highlight. */
    --sheet: color-mix(in srgb, var(--paper), white 45%);
    background:
      radial-gradient(9rem circle at var(--mx, -99rem) var(--my, -99rem), rgb(255 255 255 / 0.4), transparent 70%),
      linear-gradient(color-mix(in srgb, var(--sheet) 72%, transparent), var(--sheet) 55%);
    width: min(31rem, calc(100vw - 2rem));
    max-height: calc(100dvh - 2rem);
    margin: auto;
    padding: 1.6rem 1.5rem 1.4rem;
    overflow: auto;
    border: 0;
    border-radius: 22px;
    color: var(--ink);
    text-align: center;
    opacity: 0;
    transform: translateY(10px) scale(0.96);
    transition:
      opacity 0.25s ease,
      transform 0.45s var(--spring),
      overlay 0.45s allow-discrete,
      display 0.45s allow-discrete;
  }

  .sheet:popover-open {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.3rem;
    opacity: 1;
    transform: none;
  }

  @starting-style {
    .sheet:popover-open {
      opacity: 0;
      transform: translateY(10px) scale(0.96);
    }
