---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import goya from "../assets/goya-sleep-of-reason.jpg";
---

<BaseLayout title="Leo Gardberg — working with social robots">
  <div class="page">
    <figure class="plate">
      <Picture
        src={goya}
        formats={["avif", "webp"]}
        widths={[480, 720, 960, 1200, 1500, 1800]}
        sizes="(max-width: 767px) 20rem, (max-aspect-ratio: 1/1) 20rem, 40vh"
        quality={40}
        loading="eager"
        fetchpriority="high"
        alt="Goya's etching The Sleep of Reason Produces Monsters: a man asleep at a desk inscribed with the title, while owls and bats rise behind him."
      />
      <figcaption class="credit">
        Goya, <cite>El sueño de la razón produce monstruos</cite>, 1799
      </figcaption>
    </figure>

    <main class="content">
      <header class="intro">
        <div class="nameRow">
          <h1 class="name">Leo Gardberg</h1>
          <!-- Avatar icons from Hive Workshop (hiveworkshop.com), by bigapple90, 67chrome, FrIkY, Sopho, Elf Knight-, Freezer, Scias, LoDown, Darkfang. -->
          <span
            id="avatar"
            class="avatar"
            aria-hidden="true"
            title="Warcraft III icons by bigapple90, 67chrome, FrIkY, Sopho, Elf Knight-, Freezer, Scias, LoDown, Darkfang (Hive Workshop)"
            data-srcs="/avatar-carrion-swarm.jpg,/avatar-sylvanas.jpg,/avatar-warglaive.jpg,/avatar-ninja.jpg,/avatar-rivendare.jpg,/avatar-electric-blizzard.jpg,/avatar-tyrande.jpg,/avatar-cultist-rogue.jpg,/avatar-rocket-boots.jpg,/avatar-frost-lich.jpg,/avatar-cultist-assassin.jpg"
          >
            <img src="/avatar-carrion-swarm.jpg" alt="" class="avatarLayer isTop" width="44" height="44" />
            <img src="/avatar-sylvanas.jpg" alt="" class="avatarLayer" width="44" height="44" />
          </span>
        </div>
        <p class="tagline">
          Working with social robots
          <span class="atFurhat">@ <a href="https://furhatrobotics.com" target="_blank" rel="noopener" class="logoLink"><span class="logo" role="img" aria-label="Furhat Robotics"></span></a></span>
        </p>
        <!-- Peon icon by Kristiel (Hive Workshop, "BTNW3/1Peon Variants"). -->
        <p class="quote">
          <img src="/peon.jpg" alt="" class="quoteIcon" width="24" height="24" title="Peon icon by Kristiel (Hive Workshop)" />
          <span><q>Work work.</q> <span class="quoteBy">— Peon, <cite>Warcraft III</cite> (2002)</span></span>
        </p>
      </header>

      <section class="projects" aria-label="Projects">
        <h2 class="srOnly">Projects</h2>

        <article class="project">
          <header class="projectHead">
            <h3 class="projectTitle">Misty Connect</h3>
            <img src="/misty-connect-icon.png" alt="" class="appIcon" width="28" height="28" />
            <div class="projectMeta">
              <span class="techIcon techFlutter" role="img" aria-label="Flutter" title="Flutter">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M14.314 0L2.3 12 6 15.7 21.684.013h-7.37zm.014 11.072L7.857 17.53l6.471 6.47H21.7l-6.46-6.468 6.46-6.46z"/></svg>
              </span>
              <span class="techIcon" title="Dart"><img src="/dart-logo.png" alt="Dart" width="48" height="48" /></span>
              <span class="techIcon techBle" role="img" aria-label="Bluetooth Low Energy" title="Bluetooth Low Energy">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.71 7.71L12 2h-1v7.59L6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 11 14.41V22h1l5.71-5.71-4.3-4.29 4.3-4.29zM13 5.83l1.88 1.88L13 9.59V5.83zm1.88 10.46L13 18.17v-3.76l1.88 1.88z"/></svg>
              </span>
            </div>
          </header>
          <p class="projectBlurb">
            Gets a Misty II onto your Wi-Fi over Bluetooth. Find the robot, send it your network credentials, and get back the IP it was assigned.
          </p>
          <p class="projectNote">
            The official replacement for the removed Misty App, so owners of Misty II (built by Misty Robotics in Boulder, Colorado) can get their robots online for research, teaching or private use.
          </p>
          <details class="expand">
            <summary class="expandToggle">
              <span class="expandText" data-closed="technical details +" data-open="hide −" aria-hidden="true"></span>
              <span class="srOnly">Toggle technical details</span>
            </summary>
            <ul class="expandBody">
              <li>BLE discovery of nearby Misty II robots.</li>
              <li>Custom GATT service to exchange Wi-Fi credentials and read back the assigned IP.</li>
              <li>Pure-Dart protocol layer, fully unit-tested.</li>
              <li>Local cache of seen robots for one-tap reconnects.</li>
            </ul>
          </details>
          <!-- Official store badges, unmodified, per Apple's and Google's guidelines. -->
          <div class="badges">
            <a href="https://apps.apple.com/us/app/misty-connect/id6771731417" target="_blank" rel="noopener" class="badge">
              <img src="/badge-app-store.svg" alt="Download on the App Store" width="120" height="40" />
            </a>
            <a href="https://play.google.com/store/apps/details?id=com.furhat.misty_connect" target="_blank" rel="noopener" class="badge badgePlay">
              <img src="/badge-google-play.png" alt="Get it on Google Play" width="154" height="60" />
            </a>
          </div>
        </article>

        <article class="project">
          <header class="projectHead">
            <h3 class="projectTitle">Furhatling</h3>
            <div class="projectMeta">
              <span class="metaLabel">Petdex</span>
              <span class="techIcon" title="Codex"><img src="/codex-logo.png" alt="Codex CLI" width="40" height="40" /></span>
              <span class="techIcon techClaude" role="img" aria-label="Claude" title="Claude">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.709 15.955l4.72-2.647.08-.23-.08-.128H9.2l-.79-.048-2.698-.073-2.339-.097-2.266-.122-.571-.121L0 11.784l.055-.352.48-.321.686.06 1.52.103 2.278.158 1.652.097 2.449.255h.389l.055-.157-.134-.098-.103-.097-2.358-1.596-2.552-1.688-1.336-.972-.722-.491-.365-.462-.158-1.008.656-.722.881.06.225.061.893.686 1.908 1.476 2.491 1.833.365.304.146-.103.018-.073-.164-.274-1.355-2.448-1.446-2.49-.644-1.032-.17-.619a2.97 2.97 0 0 1-.104-.729L6.283.134 6.696 0l.996.134.42.364.62 1.414 1.002 2.229 1.555 3.03.456.898.243.832.091.255h.158V9.01l.128-1.706.237-2.095.23-2.695.08-.76.376-.91.747-.492.584.28.48.685-.067.444-.286 1.851-.559 2.903-.364 1.942h.212l.243-.242.985-1.306 1.652-2.064.73-.82.85-.904.547-.431h1.033l.76 1.129-.34 1.166-1.064 1.347-.881 1.142-1.263 1.7-.79 1.36.073.11.188-.02 2.856-.606 1.543-.28 1.841-.315.833.388.091.395-.328.807-1.969.486-2.309.462-3.439.813-.042.03.049.061 1.549.146.662.036h1.622l3.02.225.79.522.474.638-.079.485-1.215.62-1.64-.389-3.829-.91-1.312-.329h-.182v.11l1.093 1.068 2.006 1.81 2.509 2.33.127.578-.322.455-.34-.049-2.205-1.659-.851-.747-1.927-1.622h-.128v.17l.444.649 2.345 3.521.122 1.08-.17.353-.608.213-.668-.122-1.374-1.925-1.415-2.167-1.143-1.943-.14.08-.674 7.254-.316.37-.729.28-.607-.461-.322-.747.322-1.476.389-1.924.315-1.53.286-1.9.17-.632-.011-.042-.14.018-1.434 1.967-2.18 2.945-1.726 1.845-.414.164-.717-.37.067-.662.401-.589 2.388-3.036 1.44-1.882.93-1.086-.006-.158h-.055L4.132 18.56l-1.13.146-.487-.456.061-.746.231-.243 1.908-1.312z"/></svg>
              </span>
            </div>
          </header>
          <p class="projectBlurb">
            A desktop companion pet for Petdex, inspired by the Furhat social robot. It reacts to what your local Codex and Claude Code sessions are doing.
          </p>
          <div class="previewBody">
            <figure class="previewItem">
              <img src="/furhatling-idle.gif" alt="Furhatling idle animation" class="previewGif" width="192" height="208" loading="lazy" />
              <figcaption class="previewLabel">idle</figcaption>
            </figure>
            <figure class="previewItem">
              <img src="/furhatling-running.gif" alt="Furhatling running animation" class="previewGif" width="192" height="208" loading="lazy" />
              <figcaption class="previewLabel">running</figcaption>
            </figure>
            <figure class="previewItem">
              <img src="/furhatling-waiting.gif" alt="Furhatling waiting animation" class="previewGif" width="192" height="208" loading="lazy" />
              <figcaption class="previewLabel">waiting</figcaption>
            </figure>
            <figure class="previewItem">
              <img src="/furhatling-review.gif" alt="Furhatling review animation" class="previewGif" width="192" height="208" loading="lazy" />
              <figcaption class="previewLabel">review</figcaption>
            </figure>
            <figure class="previewItem">
              <img src="/furhatling-failed.gif" alt="Furhatling failed animation" class="previewGif" width="192" height="208" loading="lazy" />
              <figcaption class="previewLabel">failed</figcaption>
            </figure>
          </div>
          <p class="links">
            <a href="https://github.com/Leoxd19/furhatling-petdex" target="_blank" rel="noopener">Source<span aria-hidden="true">&nbsp;↗</span></a>
            <span class="sep" aria-hidden="true">·</span>
            <a href="https://petdex.dev/" target="_blank" rel="noopener">petdex.dev<span aria-hidden="true">&nbsp;↗</span></a>
          </p>
        </article>
        <article class="project">
          <header class="projectHead">
            <h3 class="projectTitle">Sudda mig</h3>
            <!-- Sudd, the suddamig.se mascot (vector from that site, light theme colors) -->
            <svg class="sudd" viewBox="0 0 140 110" role="img" aria-label="Sudd, the Sudda mig eraser mascot">
              <g transform="rotate(-10 70 52)">
                <rect x="14" y="22" width="112" height="62" rx="14" fill="#ffffff" stroke="#0b1220" stroke-width="5"/>
                <path d="M28 22H62V84H28Q14 84 14 70V36Q14 22 28 22Z" fill="#2541e8" stroke="#0b1220" stroke-width="5" stroke-linejoin="round"/>
                <line x1="62" y1="30" x2="62" y2="76" stroke="#0b1220" stroke-width="5"/>
                <circle cx="84" cy="48" r="5.5" fill="#0b1220"/>
                <circle cx="106" cy="48" r="5.5" fill="#0b1220"/>
                <path d="M83 62Q95 71 107 62" fill="none" stroke="#0b1220" stroke-width="5" stroke-linecap="round"/>
              </g>
              <rect x="10" y="96" width="9" height="9" rx="2" fill="#2541e8" stroke="#0b1220" stroke-width="2.5"/>
              <rect x="27" y="100" width="7" height="7" rx="2" fill="#ffffff" stroke="#0b1220" stroke-width="2.5"/>
              <rect x="41" y="96" width="6" height="6" rx="2" fill="#2541e8" stroke="#0b1220" stroke-width="2.5"/>
            </svg>
          </header>
          <p class="projectBlurb">
            A free step-by-step guide to removing yourself from Swedish people-search sites like Ratsit, Hitta, MrKoll and Merinfo. No login, no tracking, no cookies.
          </p>
          <details class="expand">
            <summary class="expandToggle">
              <span class="expandText" data-closed="details +" data-open="hide −" aria-hidden="true"></span>
              <span class="srOnly">Toggle details</span>
            </summary>
            <ul class="expandBody">
              <li>Covers Ratsit, Hitta, MrKoll, Merinfo, Eniro, Birthday and more.</li>
              <li>Progress is saved only in your own browser.</li>
              <li>Counts total page views, nothing about the visitor.</li>
            </ul>
          </details>
          <p class="links">
            <a href="https://suddamig.se" target="_blank" rel="noopener">suddamig.se<span aria-hidden="true">&nbsp;↗</span></a>
            <span class="sep" aria-hidden="true">·</span>
            <a href="https://github.com/Leoxd19/suddamig" target="_blank" rel="noopener">Source<span aria-hidden="true">&nbsp;↗</span></a>
          </p>
        </article>
      </section>

    </main>
  </div>
</BaseLayout>

<script>
  // Avatar cycle through the Warcraft III icons listed in data-srcs, as a
  // crossfade between two stacked layers: the next icon fades in on top of
  // the current one, so there is never an empty frame (fading out to
  // nothing and back read as a blink). Each image is decoded before its
  // fade starts so it can't pop in mid-transition. Pauses while the tab is
  // hidden; with prefers-reduced-motion there's no autoplay, and a hover or
  // tap steps to the next icon instead. Taps also step it on touch screens.
  const frame = document.getElementById("avatar");
  const layers = frame ? Array.from(frame.querySelectorAll<HTMLImageElement>(".avatarLayer")) : [];
  if (frame && layers.length === 2) {
    const sources = (frame.dataset.srcs ?? "").split(",").filter(Boolean);
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const HOLD_MS = 3500;
    const FADE_MS = 900; // keep in sync with .avatarLayer's transition
    let i = 0;
    let top = 0;
    let busy = false;
    let timer: number | undefined;

    // Preload the rest so every crossfade has its image ready.
    sources.slice(2).forEach((src) => {
      const img = new Image();
      img.src = src;
    });

    const next = async () => {
      if (busy) return;
      busy = true;
      i = (i + 1) % sources.length;
      const incoming = layers[1 - top];
      const outgoing = layers[top];
      incoming.src = sources[i];
      try {
        await incoming.decode();
      } catch {
        // Decode can reject for cached or aborted images; show it anyway.
      }
      incoming.style.zIndex = "2";
      outgoing.style.zIndex = "1";
      incoming.classList.add("isTop");
      // Drop the old layer only once the new one is fully opaque above it.
      window.setTimeout(() => {
        outgoing.classList.remove("isTop");
        top = 1 - top;
        busy = false;
      }, reduceMotion ? 0 : FADE_MS);
    };

    const play = () => {
      if (timer === undefined) timer = window.setInterval(next, HOLD_MS);
    };

    const pause = () => {
      if (timer !== undefined) {
        clearInterval(timer);
        timer = undefined;
      }
    };

    if (reduceMotion) {
      frame.addEventListener("mouseenter", next);
    } else {
      play();
      document.addEventListener("visibilitychange", () => {
        if (document.hidden) pause();
        else play();
      });
    }

    // Touch: a tap steps to the next icon.
    frame.addEventListener("touchstart", next, { passive: true });
  }
</script>

<style>
  /* A centred, symmetric composition: print, gap and text column form one
     block centred in the viewport, so the outer margins are equal. The
     print is 60% of the viewport height at its own 2645:4000 ratio (never
     cropped) and sits on the paper like a real impression of the
     Caprichos, its centre level with the centre of the text. */
  .page {
    --plate-h: clamp(18rem, 60vh, 44rem);
    --plate-h: clamp(18rem, 60dvh, 44rem);
    --plate-w: calc(var(--plate-h) * 0.66125);
    display: grid;
    grid-template-columns: var(--plate-w) minmax(0, 46rem);
    justify-content: center;
    align-items: center;
    column-gap: clamp(3rem, 6vw, 7rem);
    min-height: 100vh;
    min-height: 100dvh;
    padding-inline: clamp(1.5rem, 4vw, 4rem);
  }

  /* The credit hangs below the print without counting toward its box, so
     the image itself, not image + caption, is what gets centred. */
  .plate {
    position: relative;
  }

  /* <Picture> renders its own elements, outside this component's style
     scope, hence :global(). */
  .plate :global(picture) {
    display: block;
    height: var(--plate-h);
  }

  /* A barely-there radius: real etching plates have their corners filed
     round so they don't cut the paper, which softens the plate mark. */
  .plate :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  /* Fits one screen on desktop: the whole column sits within the viewport
     height, vertically centred against the print. */
  .content {
    --band-w: 22rem;
    display: flex;
    flex-direction: column;
    gap: clamp(1.25rem, 3vh, 3rem);
    padding-block: clamp(0.75rem, 2.5vh, 2rem);
  }

  /* --- Intro ----------------------------------------------------- */

  .intro {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  /* Circular profile avatar: Warcraft III hero icons (Hive Workshop),
     duotoned in the page's ink and paper so they read like the etching.
     Starts on Carrion Swarm (bats) and cycles through the set on its own. */
  .avatar {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .avatar:hover {
    transform: scale(1.08);
  }

  /* Two stacked layers for the crossfade; only .isTop is visible. */
  .avatarLayer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.9s ease-in-out;
  }

  .avatarLayer.isTop {
    opacity: 1;
  }

  /* Heading bands: the name row and each project title sit on the same tab
     of a deeper paper tone. On desktop every tab has one shared width
     (sized to the longest title row), so they line up as a set without
     running the full column; phones get full-width bands. Each band hangs
     into the gutter so its text still aligns with the text below. */
  .nameRow,
  .projectHead {
    width: max-content;
    min-width: var(--band-w);
    max-width: calc(100% + 1.2rem);
    margin-inline: -0.6rem;
    padding: 0.2rem 0.6rem;
    background: var(--band);
    border-radius: var(--radius);
  }

  /* Name then avatar on one band, in the same order and spacing as the
     project rows (title, then icon), so all four bands read alike. Only
     its colours differ (inverted), marking it as the page's title. */
  .nameRow {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    background: var(--band-name);
    color: var(--paper);
  }

  /* Deliberately quiet: position and the avatar already mark this as the
     page's title, so size and weight don't have to shout. */
  .name {
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.75rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .tagline {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.2rem 0.45rem;
    color: var(--ink);
  }

  /* The peon's line, as a small aside to "working with social robots". The
     icon keeps its green on purpose: in duotone he stops reading as a peon. */
  .quote {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.15rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .quoteIcon {
    width: 24px;
    height: 24px;
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  /* The attribution wraps as one unit, never leaving "(2002)" alone. */
  .quoteBy {
    color: var(--ink-muted);
    white-space: nowrap;
  }

  .quoteBy cite {
    font-style: normal;
  }

  /* "@" and the logo stay together, so on narrow screens the line breaks
     at the natural pause instead of leaving "@" dangling. The logo artwork
     starts ~7% into its image, so it's pulled left to sit about one normal
     space from the "@". */
  .atFurhat {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
  }

  .atFurhat .logoLink {
    margin-left: -0.35rem;
  }

  .logoLink {
    display: inline-block;
    color: var(--ink);
    line-height: 0;
  }

  /* The wordmark is a transparent mask filled with currentColor, so it
     always matches the text ink instead of carrying its own black. The
     artwork has generous built-in padding, hence the larger box. */
  .logo {
    display: block;
    width: 150px;
    aspect-ratio: 560 / 156;
    margin-block: -0.4rem;
    background: currentColor;
    -webkit-mask: url("/furhat-logo-mask.png") center / contain no-repeat;
    mask: url("/furhat-logo-mask.png") center / contain no-repeat;
  }

  /* --- Projects -------------------------------------------------- */

  /* No cards or rules: the title bands mark each project, so the gap
     between projects can stay modest. */
  .projects {
    display: flex;
    flex-direction: column;
    gap: clamp(0.9rem, 1.7vh, 2rem);
  }

  .project {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }

  /* Title and stack on one line: the project's identity row. */
  .projectHead {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }

  .projectTitle {
    font-size: 1.3rem;
    line-height: 1.25;
    letter-spacing: -0.015em;
  }

  /* Machine details (toggles, labels) are set in mono, small and muted:
     one consistent "label" voice under the sans reading voice. */
  .expandToggle,
  .previewLabel,
  .metaLabel {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--ink-muted);
  }

  .projectMeta {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }

  .techIcon {
    display: inline-flex;
    line-height: 0;
  }

  .techIcon svg {
    width: 17px;
    height: 17px;
  }

  .techIcon img {
    width: 19px;
    height: 19px;
    object-fit: contain;
  }

  /* Brand colors, each the brand's own darker shade (or deepened just
     enough) to clear 3:1 against the paper. Raster logos keep their art. */
  .techFlutter { color: #02569b; }
  .techBle     { color: #0a5bc4; }
  .techClaude  { color: #a94e2f; }

  /* App icon artwork is square; the store applies the rounded mask, so we
     round it the same way (~22% radius, like iOS) to read as an app icon. */
  .appIcon {
    width: 28px;
    height: 28px;
    border-radius: 22%;
  }

  .sudd {
    width: 34px;
    height: auto;
    overflow: visible;
  }

  /* Descriptions use the full column width (~70–80 characters on desktop)
     with plain greedy wrapping: no ch cap and no text-wrap: pretty, both of
     which broke lines early and left short, ragged lines. */
  .projectBlurb {
    max-width: none;
  }

  /* Background context, quieter than the description it follows. */
  .projectNote {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--ink-muted);
  }

  /* --- Links ------------------------------------------------------ */

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-top: 0.15rem;
  }

  .links a {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.25em;
    transition: text-decoration-color 0.15s ease;
